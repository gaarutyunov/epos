---
import { readFileSync } from "node:fs";
import Base from "../layouts/Base.astro";

// The recipe lives at exactly one path in the repository and this page reads it
// from there. A second copy pasted into the markup is a copy that goes stale
// the first time the Skillfile is touched, which is the failure this whole page
// is about.
const read = (path: string) =>
  readFileSync(new URL(`../../../${path}`, import.meta.url), "utf8").trimEnd();

const skillfile = read("examples/go-house/Skillfile");
const valuesLibrary = read("examples/go-house/values-library.yaml");
const valuesService = read("examples/go-house/values-service.yaml");

// Only the stages, so the page shows the shape before it shows the detail. The
// full file is below, and it is the same string.
const stages = skillfile
  .split("\n")
  .filter((line) => line.startsWith("FROM ") || line.startsWith("ARG "))
  .join("\n");

const skillmd = `---
name: reviewer
version: "1.0.0"
description: Reviews a pull request against our house standard.
---

# Reviewer

Review in {{ .Values.language }}. Escalate anything you would block on.`;

const values = `language: Go
global:
  org: Acme`;

// BASE_URL carries a trailing slash only when `base` was written with one, so
// joining by hand is what keeps a link off /pr-preview/pr-1skillfile.
const href = (path: string) =>
  `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${path}`;

const contents = [
  ["install", "Install"],
  ["use", "Use a published skill"],
  ["author", "Author your own"],
  ["derive", "Derive one skill from five"],
  ["parameters", "Turn features off, and back on"],
];
---

<Base
  title="Quick start — Epos"
  description="Install a published skill, author your own, derive one skill from five others, and turn its features on and off with a values file."
  crumb="Quick start"
>
  <div class="doc">
    <div class="doc-main">
      <h1>Quick start</h1>
      <p class="lede">
        Two paths — use a skill someone published, or publish your own — then
        the thing epos is actually for: one skill derived from five, with its
        dependencies on a switch.
      </p>

      <section id="install">
        <h2 class="section-label">Install</h2>
        <ga-code prompt="$"
          >go install github.com/gaarutyunov/epos/cmd/epos@latest</ga-code
        >
        <ga-code prompt="$">export EPOS_HOME="$PWD/.epos"</ga-code>
        <p>
          <code>EPOS_HOME</code> is optional; without it the store is
          <code>~/.epos</code>. Setting it makes this a throwaway.
        </p>
      </section>

      <section id="use">
        <h2 class="section-label">Use a published skill</h2>
        <ga-code prompt="$"
          >epos pull ghcr.io/acme/agent-skills/reviewer:1.0.0</ga-code
        >
        <p class="filename"><code>values.yaml</code></p>
        <pre class="file">{values}</pre>
        <ga-code prompt="$">epos install reviewer:1.0.0 -f values.yaml</ga-code>
        <ga-code prompt="$">epos ls</ga-code>
        <pre
          class="out">reviewer:1.0.0 sha256:a32fa1dfea1118829a06ab4975e38ca502cc3c3f1ccfdab909f846276f486558</pre>
        <p>
          The skill is now in <code>.claude/skills/reviewer/</code> with your
          values filled in, and the digest is pinned in
          <code>skills.lock.json</code>. Commit the lock file.
        </p>
        <ga-note tone="info" title="install resolves, it does not fetch">
          <code>install</code> reads the local store. Run <code>pull</code> or
          <code>build</code> first, and a value the skill needs but nobody
          supplied fails the install rather than rendering a hole.
        </ga-note>
      </section>

      <section id="author">
        <h2 class="section-label">Author your own</h2>
        <p class="filename"><code>reviewer/SKILL.md</code></p>
        <pre class="file">{skillmd}</pre>
        <ga-code prompt="$">epos pack ./reviewer</ga-code>
        <pre
          class="out">reviewer:1.0.0 sha256:a32fa1dfea1118829a06ab4975e38ca502cc3c3f1ccfdab909f846276f486558</pre>
        <ga-code prompt="$">epos registry login ghcr.io -u you</ga-code>
        <ga-code prompt="$"
          >epos push reviewer:1.0.0 oci://ghcr.io/acme/agent-skills</ga-code
        >
        <p>
          Nothing is repacked on the way out, so the digest <code>pack</code>
          printed is the digest that arrives. Any other OCI client publishes it
          just as well —
          <code
            >oras cp --from-oci-layout-path "$(epos store path)"
            reviewer:1.0.0 …</code
          >.
        </p>
      </section>

      <section id="derive">
        <h2 class="section-label">Derive one skill from five</h2>
        <p>
          The workspace routes Go work at five skills that disagree with each
          other. One <code>Skillfile</code> settles it: five stages, each from
          its own source, and one artifact that reads as though it was written
          that way.
        </p>
        <pre class="file">{stages}</pre>
        <p>
          Each stage is edited where it is wrong and copied where it is right.
          <code>RM</code> drops a file whole; <code>AWK</code> drops a section on
          its heading; <code>REPLACE</code> takes a block out of a section that
          is otherwise kept, or wraps one in a condition.
        </p>
        <ga-note tone="success" title="Why deriving beats forking">
          The house rule against Viper had to live <em>outside</em> spf13's CLI
          skill, in a separate rules file, because an edit inside a vendored
          skill is lost the next time it is installed. The
          <code>cli</code> stage puts it back in: the Viper section is dropped and
          the house's koanf answer takes its place, and it survives the next upstream
          release because it is a recipe rather than a patch.
        </ga-note>
        <ga-code prompt="$">epos build -t go-house:0.1.0 examples/go-house</ga-code>
        <details>
          <summary>The whole recipe</summary>
          <pre class="file">{skillfile}</pre>
        </details>
      </section>

      <section id="parameters">
        <h2 class="section-label">Turn features off, and back on</h2>
        <p>
          The base skill mandates an OpenAPI generator, a dependency-injection
          graph, a telemetry registry and containers for the integration suite.
          A single-purpose library has none of those.
        </p>
        <p class="filename"><code>examples/go-house/values-library.yaml</code></p>
        <pre class="file">{valuesLibrary}</pre>
        <ga-code prompt="$"
          >epos install go-house:0.1.0 -f examples/go-house/values-library.yaml</ga-code
        >
        <p>
          Four sections and two generator lines are gone from the installed
          skill. Change your mind and apply the other profile:
        </p>
        <p class="filename"><code>examples/go-house/values-service.yaml</code></p>
        <pre class="file">{valuesService}</pre>
        <ga-code prompt="$"
          >epos install go-house:0.1.0 -f examples/go-house/values-service.yaml</ga-code
        >
        <p>
          They are back, and nothing was rebuilt — the artifact in the store did
          not change, only the values did.
        </p>
        <ga-note tone="warning" title="Booleans belong in the file">
          <!-- epos#47: delete this note and the --set form in it when --set
               infers types the way helm's pkg/strvals does. -->
          <code>--set x=false</code> stores the string <code>"false"</code>,
          which is truthy, so it turns nothing off — see
          <a href="https://github.com/gaarutyunov/epos/issues/47">epos#47</a>.
          The one-off off-switch is <code>--set x=</code>; a real boolean needs a
          values file.
        </ga-note>
      </section>
    </div>

    <aside class="doc-aside">
      <div>
        <h2 class="section-label">On this page</h2>
        <ul class="rows">
          {
            contents.map(([id, label]) => (
              <li>
                <a href={`#${id}`}>
                  <span>{label}</span>
                  <span class="arrow">→</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="section-label">Reference</h2>
        <ul class="rows">
          <li>
            <a href={href("cli")}>
              <span>CLI</span>
              <span class="arrow">→</span>
            </a>
          </li>
          <li>
            <a href={href("skillfile")}>
              <span>Skillfile</span>
              <span class="arrow">→</span>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/gaarutyunov/epos/tree/main/examples/go-house"
            >
              <span>examples/go-house</span>
              <span class="arrow">↗</span>
            </a>
          </li>
        </ul>
      </div>
    </aside>
  </div>
</Base>

<style>
  .filename {
    margin: var(--ga-space-4, 16px) 0 var(--ga-space-2, 8px);
    font-family: var(--ga-font-mono);
    font-size: var(--ga-fs-xs, 12px);
    text-transform: uppercase;
    color: var(--ga-dim, #454545);
  }

  .file,
  .out {
    padding: var(--ga-space-3, 12px) var(--ga-space-4, 16px);
    border: 1px solid var(--ga-border, #1a1a1a);
    border-radius: var(--ga-radius, 6px);
    background: color-mix(in srgb, var(--ga-bg-elev, #1a1a1a) 40%, transparent);
    color: var(--ga-fg, #ededed);
  }

  .out {
    color: var(--ga-muted, #878787);
  }

  details {
    margin-bottom: var(--ga-space-4, 16px);
  }

  summary {
    cursor: pointer;
    font-family: var(--ga-font-mono);
    font-size: var(--ga-fs-sm, 14px);
    color: var(--ga-muted, #878787);
    margin-bottom: var(--ga-space-3, 12px);
  }

  summary:hover {
    color: var(--ga-fg, #ededed);
  }

  .arrow {
    font-family: var(--ga-font-mono);
    font-size: var(--ga-fs-xs, 12px);
  }
</style>
