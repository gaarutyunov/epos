---
import Base from "../layouts/Base.astro";
import Wordmark from "../components/Wordmark.astro";

// BASE_URL carries a trailing slash only when `base` was written with one, so
// joining by hand is what keeps a link off /pr-preview/pr-1skillfile.
const href = (path: string) =>
  `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${path}`;

// Every card is a capability the shipped CLI has. Adding one that is only
// planned is how a landing page starts lying, so each of these names the
// command or the file that does it.
const features = [
  {
    title: "An artifact, not an attachment",
    body: "A skill directory becomes a standard OCI artifact — content-addressed, tagged, and pullable by oras or any other conforming client. No new server, no new account, no daemon.",
    meta: "epos pack",
  },
  {
    title: "Compose instead of forking",
    body: "Start from a skill someone else publishes, remove the parts that do not apply, rewrite the parts that nearly do, and keep the rest. A fork you have to re-merge becomes a recipe you re-run.",
    meta: "epos build",
  },
  {
    title: "Several bases, one skill",
    body: "Named stages, each from its own source, and cross-stage copies between them. Five published skills can become one that reads as though it was written that way.",
    meta: "FROM … AS · COPY --from",
  },
  {
    title: "Parameters, resolved at install",
    body: "The artifact ships its templates untouched; your values fill them in on the machine that installs it. Turn a dependency off for one project and back on for the next without rebuilding.",
    meta: "epos install -f values.yaml",
  },
  {
    title: "Pinned, and reproducible",
    body: "Every worktree records the digest it installed, and the same recipe over the same bases always produces the same bytes. A build is a pure function; nothing executes.",
    meta: "skills.lock.json",
  },
  {
    title: "Signed and verifiable",
    body: "Sign a published skill and attest what it was built from, as OCI referrers, then verify before you install. The provenance travels with the artifact rather than beside it.",
    meta: "epos sign · attest · verify",
  },
];
---

<Base
  title="Epos — OCI-native packaging for agent skills"
  description="Epos packages agent skills as OCI artifacts and composes them: derive one skill from several, parameterise it, and install it with your own values."
>
  <section class="hero">
    <div class="hero-mark">
      <h1 class="sr-only">Epos</h1>
      <Wordmark />
    </div>
    <p class="hero-line">
      Package agent skills the way you already package everything else, and
      build new ones out of the ones you trust.
    </p>
  </section>

  <section class="band">
    <div class="band-left">
      <h2 class="section-label">Install</h2>
      <ga-code prompt="$"
        >go install github.com/gaarutyunov/epos/cmd/epos@latest</ga-code
      >
      <p class="band-links">
        <ga-button variant="primary" href={href("quickstart")}>
          Quick start
        </ga-button>
        <ga-button href={href("cli")}>Reference</ga-button>
      </p>
    </div>
    <div class="band-right">
      <h2 class="section-label">What it is for</h2>
      <ul class="dashed">
        <li>
          Pin the skill your agent runs, the way you pin a container image.
        </li>
        <li>
          Derive a house skill from several published ones, and rebuild it when
          they move.
        </li>
        <li>
          Ship one artifact and let each project decide which parts of it apply.
        </li>
      </ul>
    </div>
  </section>

  <section>
    <h2 class="section-label">Features</h2>
    <div class="cards">
      {
        features.map((feature) => (
          <article class="card">
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
            <span class="card-meta">{feature.meta}</span>
          </article>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--ga-space-10, 40px);
    margin: var(--ga-space-6, 24px) 0 var(--ga-space-12, 48px);
  }

  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 3.5rem;
    }
  }

  .hero-mark {
    min-width: 0;
  }

  .hero-line {
    display: flex;
    align-items: center;
    margin: 0;
    font-size: var(--ga-fs-xl, 24px);
    line-height: 1.2;
    letter-spacing: var(--ga-tracking-tight, -0.02em);
    text-wrap: balance;
    color: var(--ga-muted, #878787);
  }

  @media (min-width: 1024px) {
    .hero-line {
      font-size: 30px;
    }
  }

  .band {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--ga-space-10, 40px);
    margin-bottom: var(--ga-space-12, 48px);
  }

  @media (min-width: 1024px) {
    .band {
      grid-template-columns: minmax(20rem, auto) minmax(0, 1fr);
      gap: 3.5rem;
    }
  }

  .band-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ga-space-3, 12px);
    margin: var(--ga-space-4, 16px) 0 0;
  }

  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--ga-space-4, 16px);
  }

  @media (min-width: 640px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Border-only over a low-alpha fill, and the hover moves colour and nothing
     else — no lift, no shadow, no scale. */
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--ga-space-3, 12px);
    padding: var(--ga-space-5, 20px);
    border: 1px solid var(--ga-border, #1a1a1a);
    border-radius: var(--ga-radius-lg, 8px);
    background: color-mix(in srgb, var(--ga-bg-elev, #1a1a1a) 30%, transparent);
    transition:
      background var(--ga-transition, 0.18s),
      border-color var(--ga-transition, 0.18s);
  }

  .card:hover {
    background: color-mix(in srgb, var(--ga-bg-elev, #1a1a1a) 60%, transparent);
    border-color: var(--ga-dim, #454545);
  }

  .card h3 {
    margin: 0;
    font-size: var(--ga-fs-base, 17px);
    font-weight: 600;
    color: var(--ga-fg, #ededed);
    transition: color var(--ga-transition, 0.18s);
  }

  .card:hover h3 {
    color: var(--ga-accent, #54a2ff);
  }

  .card p {
    margin: 0;
    font-size: var(--ga-fs-sm, 14px);
    line-height: 1.65;
  }

  .card-meta {
    margin-top: auto;
    padding-top: var(--ga-space-2, 8px);
    font-family: var(--ga-font-mono);
    font-size: var(--ga-fs-xs, 12px);
    color: var(--ga-dim, #454545);
  }
</style>
