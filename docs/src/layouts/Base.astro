---
// tokens.css carries the shared design language and is safe to import here:
// Astro extracts it at build time. The components themselves are *not* — they
// extend HTMLElement, which does not exist while Astro pre-renders in Node, so
// registering them has to happen in the browser (see the script below).
//
// Both come from the vendored copy in docs/vendor, pinned at ui-kit v0.2.0.
import "../../vendor/ui-kit/src/tokens/tokens.css";

interface Props {
  title: string;
  description: string;
  /**
   * The second breadcrumb. A page that sets it is a docs page: it gets the
   * crumb, and its own `h1` is expected to be visible. The landing sets none —
   * a breadcrumb whose only entry is the page you are already on says nothing.
   */
  crumb?: string;
}

const { title, description, crumb } = Astro.props;

// BASE_URL carries a trailing slash only when `base` was written with one, so
// joining by hand turns "/pr-preview/pr-1" + "favicon-32.png" into
// "/pr-preview/pr-1favicon-32.png".
const asset = (path: string) =>
  `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${path}`;

// Social scrapers reject relative image URLs, so og:image and twitter:image
// have to be absolute. Resolving against Astro.site keeps a PR preview
// pointing at its own copy of the image rather than the main deployment's.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(asset("og-image.png"), Astro.site);

const nav = [
  { label: "Quick start", href: asset("quickstart") },
  { label: "CLI", href: asset("cli") },
  { label: "Skillfile", href: asset("skillfile") },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={asset("favicon-32.png")}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href={asset("icon-192.png")}
    />
    <link rel="apple-touch-icon" href={asset("apple-touch-icon.png")} />
    <!--
      The manifest's own icon paths are relative to the manifest URL, not to the
      page, so they follow a PR preview into its subdirectory without needing
      BASE_URL baked into a file that Astro copies through verbatim.
    -->
    <link rel="manifest" href={asset("site.webmanifest")} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Epos" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <header class="site">
      <div class="site-inner">
        <a class="wordmark" href={asset("")}>Epos</a>
        <nav aria-label="Sections">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
          <a
            href="https://github.com/gaarutyunov/epos"
            aria-label="GitHub"
            title="GitHub"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.87-1.54-3.87-1.54-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.69 1.25 3.35.95.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.05 11.05 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.25 5.68.41.35.78 1.05.78 2.12 0 1.53-.01 2.77-.01 3.15 0 .31.21.68.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5Z"
              ></path>
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <main>
      {
        crumb && (
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href={asset("")}>Epos</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{crumb}</span>
          </nav>
        )
      }
      <slot />

      <footer class="site-footer">
        <a href="https://github.com/gaarutyunov/epos">Source</a>
        <a href="https://github.com/gaarutyunov/epos/blob/main/SPEC.md">Spec</a>
        <a href="https://github.com/gaarutyunov/epos/blob/main/LICENSE">MIT</a>
      </footer>
    </main>

    <!--
      Registering every <ga-*> element is a side effect of this import. Astro
      bundles it and ships it to the browser, which is the only place custom
      elements can be defined.
    -->
    <script>
      import "../../vendor/ui-kit/src/index.js";
    </script>

    <style is:global>
      /* ---------------------------------------------------------------
         The shell. One container for every page — the width garutyunov.com
         uses on its landing *and* on its inner pages (max-w-6xl = 1152px).
         The reading measure comes from the 9/3 grid below, not from a
         narrower container.
         --------------------------------------------------------------- */
      body {
        margin: 0;
        background: var(--ga-bg, #000);
        color: var(--ga-fg, #ededed);
        font-family: var(--ga-font-sans);
        line-height: var(--ga-lh-base, 1.65);
      }

      main {
        max-width: 72rem;
        margin: 0 auto;
        padding: 0 1rem var(--ga-space-12, 48px);
      }

      @media (min-width: 640px) {
        main {
          padding-left: 1.5rem;
          padding-right: 1.5rem;
        }
      }

      @media (min-width: 1024px) {
        main {
          padding-left: 2rem;
          padding-right: 2rem;
        }
      }

      a {
        color: var(--ga-accent, #54a2ff);
      }

      /* The sticky header sits on the opaque page background: no border, no
         blur, which is what the reference site does. */
      header.site {
        position: sticky;
        top: 0;
        z-index: 50;
        background: var(--ga-bg, #000);
      }

      header.site .site-inner {
        max-width: 72rem;
        margin: 0 auto;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--ga-space-6, 24px);
        padding: 0 1rem;
      }

      @media (min-width: 640px) {
        header.site .site-inner {
          padding: 0 1.5rem;
        }
      }

      @media (min-width: 1024px) {
        header.site .site-inner {
          padding: 0 2rem;
        }
      }

      header.site .wordmark {
        color: var(--ga-fg, #ededed);
        text-decoration: none;
        font-family: var(--ga-font-mono);
        font-size: var(--ga-fs-sm, 14px);
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      header.site .wordmark:hover {
        color: var(--ga-muted, #878787);
      }

      header.site nav {
        display: flex;
        align-items: center;
        gap: var(--ga-space-4, 16px);
      }

      @media (min-width: 640px) {
        header.site nav {
          gap: var(--ga-space-5, 20px);
        }
      }

      header.site nav a {
        color: var(--ga-muted, #878787);
        text-decoration: none;
        font-size: var(--ga-fs-sm, 14px);
        transition: color var(--ga-transition, 0.18s);
      }

      header.site nav a:hover {
        color: var(--ga-fg, #ededed);
      }

      /* --------------------------------------------------------------- */

      .crumbs {
        display: flex;
        align-items: center;
        gap: var(--ga-space-2, 8px);
        font-family: var(--ga-font-mono);
        font-size: var(--ga-fs-sm, 14px);
        padding-top: var(--ga-space-4, 16px);
        margin-bottom: var(--ga-space-6, 24px);
        color: var(--ga-muted, #878787);
      }

      .crumbs a {
        color: var(--ga-muted, #878787);
        text-decoration: none;
        transition: color var(--ga-transition, 0.18s);
      }

      .crumbs a:hover {
        color: var(--ga-fg, #ededed);
      }

      .crumbs [aria-current="page"] {
        color: var(--ga-fg, #ededed);
      }

      /* The 9/3 grid the reference site's skill pages and CV both use. At the
         1152px cap the content column lands at ~806px — inside the reading
         measure the old 832px container gave. */
      .doc {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: var(--ga-space-10, 40px);
      }

      @media (min-width: 1024px) {
        .doc {
          grid-template-columns: repeat(12, minmax(0, 1fr));
        }

        .doc-main {
          grid-column: span 9;
          min-width: 0;
        }

        .doc-aside {
          grid-column: span 3;
        }
      }

      .doc-aside {
        display: flex;
        flex-direction: column;
        gap: var(--ga-space-8, 32px);
        font-size: var(--ga-fs-sm, 14px);
        min-width: 0;
      }

      /* Above the breakpoint the aside travels with the reader; below it, it is
         an ordinary block that stacks under the content. */
      @media (min-width: 1024px) {
        .doc-aside {
          position: sticky;
          top: calc(56px + var(--ga-space-6, 24px));
          align-self: start;
          max-height: calc(100vh - 56px - var(--ga-space-12, 48px));
          overflow-y: auto;
        }
      }

      /* ---------------------------------------------------------------
         Type. The h1 and the section label are the reference site's. h2, h3,
         paragraphs, inline code, code blocks and tables are extensions:
         garutyunov.com has none of them anywhere, so they are derived from
         the scale above rather than copied from something that does not
         exist there.
         --------------------------------------------------------------- */
      h1 {
        font-size: 36px;
        line-height: 40px;
        font-weight: 600;
        letter-spacing: -0.025em;
        margin: 0 0 var(--ga-space-6, 24px);
      }

      .section-label {
        font-family: var(--ga-font-mono);
        font-size: var(--ga-fs-sm, 14px);
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0;
        color: var(--ga-fg, #ededed);
        margin: 0 0 14px;
      }

      .lede {
        font-size: var(--ga-fs-lg, 20px);
        line-height: 1.5;
        color: var(--ga-muted, #878787);
        margin: 0 0 var(--ga-space-8, 32px);
        max-width: 42rem;
      }

      h2 {
        font-size: var(--ga-fs-xl, 24px);
        font-weight: 600;
        letter-spacing: -0.02em;
        margin: 0 0 var(--ga-space-3, 12px);
      }

      h3 {
        font-size: var(--ga-fs-base, 17px);
        font-weight: 600;
        margin: var(--ga-space-6, 24px) 0 var(--ga-space-2, 8px);
      }

      p {
        color: var(--ga-muted, #878787);
        margin: 0 0 var(--ga-space-4, 16px);
      }

      code {
        font-family: var(--ga-font-mono);
        font-size: 0.9em;
      }

      pre {
        margin: 0 0 var(--ga-space-4, 16px);
        overflow-x: auto;
        font-family: var(--ga-font-mono);
        font-size: var(--ga-fs-sm, 14px);
        line-height: 1.65;
        white-space: pre;
      }

      /* The kit's block components set `:host { display: block }` and zero the
         inner margin, and no page ever supplied an outer one — which is why two
         adjacent notes used to touch at 0px. One rule, every page. */
      ga-note,
      ga-code,
      ga-card {
        display: block;
        margin-bottom: var(--ga-space-3, 12px);
      }

      ga-note + ga-note,
      ga-note + ga-code,
      ga-code + ga-note,
      ga-card + ga-card {
        margin-top: var(--ga-space-3, 12px);
      }

      section {
        margin-bottom: var(--ga-space-12, 48px);
        scroll-margin-top: calc(56px + var(--ga-space-4, 16px));
      }

      /* Em-dash bullets, the reference site's list form: a leading dash in the
         muted colour, never a real marker. */
      ul.dashed {
        list-style: none;
        padding: 0;
        margin: 0 0 var(--ga-space-4, 16px);
        display: flex;
        flex-direction: column;
        gap: var(--ga-space-2, 8px);
      }

      ul.dashed > li {
        display: flex;
        gap: var(--ga-space-3, 12px);
        color: var(--ga-muted, #878787);
      }

      ul.dashed > li::before {
        content: "—";
        flex: none;
        color: var(--ga-muted, #878787);
      }

      /* Ruled key/value rows, as on the CV. */
      ul.rows {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      ul.rows > li {
        border-bottom: 1px solid var(--ga-border, #1a1a1a);
        padding: var(--ga-space-2, 8px) 0;
      }

      ul.rows > li > a {
        display: flex;
        justify-content: space-between;
        gap: var(--ga-space-4, 16px);
        color: var(--ga-muted, #878787);
        text-decoration: none;
        transition: color var(--ga-transition, 0.18s);
      }

      ul.rows > li > a:hover {
        color: var(--ga-fg, #ededed);
      }

      .site-footer {
        display: flex;
        gap: var(--ga-space-5, 20px);
        margin-top: var(--ga-space-12, 48px);
        padding-top: var(--ga-space-6, 24px);
        border-top: 1px solid var(--ga-border, #1a1a1a);
        font-family: var(--ga-font-mono);
        font-size: var(--ga-fs-xs, 12px);
        text-transform: uppercase;
      }

      .site-footer a {
        color: var(--ga-muted, #878787);
        text-decoration: none;
      }

      .site-footer a:hover {
        color: var(--ga-fg, #ededed);
      }
    </style>
  </body>
</html>
