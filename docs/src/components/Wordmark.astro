---
// The EPOS wordmark, in the box-drawing lettering garutyunov.com and skills.sh
// both use. A <pre> and not an image: it is text, it copies as text, and it
// costs nothing to load.
//
// A component rather than inline art because the same lettering is wanted for
// the catalog (#44), and a second hand-drawn copy would drift from this one.
const BANNER = `███████╗██████╗  ██████╗ ███████╗
██╔════╝██╔══██╗██╔═══██╗██╔════╝
█████╗  ██████╔╝██║   ██║███████╗
██╔══╝  ██╔═══╝ ██║   ██║╚════██║
███████╗██║     ╚██████╔╝███████║
╚══════╝╚═╝      ╚═════╝ ╚══════╝`;
---

<pre class="wordmark" aria-label="Epos">{BANNER}</pre>

<style>
  /* Fira Mono at 125% leading with -1px tracking is what closes the gaps
     between the box-drawing characters; anything else leaves hairlines. */
  .wordmark {
    margin: 0;
    font-family: var(--ga-font-display);
    font-size: 8px;
    letter-spacing: -1px;
    line-height: 125%;
    color: var(--ga-fg, #ededed);
    user-select: none;
    white-space: pre;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .wordmark {
      font-size: 12px;
    }
  }

  @media (min-width: 1024px) {
    .wordmark {
      font-size: 16px;
    }
  }
</style>
